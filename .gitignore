# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
dist-ssr/
build/
gen/
resources/
webapp/resources/
webapp/test-resources/
*.local

# Environment & secrets
.env
.env.*
!.env.example
default-env.json
*.pem
*.key

# SAP CAP / MTA
mta_archives/
*.mtar
.cds/
cds/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test & coverage
coverage/
.nyc_output/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Gentle AI tooling cache
.atl/*.cache.json

# Python bytecode. Vite copies public/ verbatim, so anything CPython drops next
# to the vendored render core would ship in the bundle.
__pycache__/
*.pyc

# Pyodide runtime + wheels (~14 MB), staged from node_modules and the CDN by
# scripts/setup-pyodide.mjs. Regenerate with: npm run setup:pyodide
public/pyodide/

# Misc
*.tmp
tmp/
