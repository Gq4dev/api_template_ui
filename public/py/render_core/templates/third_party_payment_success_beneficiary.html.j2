{#- Ported from legacy email/third_party_payment_success_beneficiary.ftl. Consumes commerce, destination_account, destination_account_holder_name, currency, amount, authorized_date, cuit, concept, urlAdvertisingImg, linkAdvertisingImg. -#}
{% extends "base.html.j2" %}

{% block title %}{{ msg('siteTitle') }}{% endblock %}

{% block header %}
    {% include "partials/header.html.j2" %}
{% endblock %}

{% block content %}
<div style='display:block;'>
    <div style='text-align: center;'>
        <p style='font-family: Arial; font-weight: bold; font-size: 18px; color: #1E1248;'>Has recibido una transferencia</p>
    </div>
    <div style='padding:15px 30px; display:block; font-family:Arial; font-size:13px; color:#565856; text-align:center'>
        <p style='font-size:15px;color:#565856;'>
            Estimado/a:
        </p>
        <p>
            Has recibido una transferencia de <strong>{{ commerce.fantasy_name or commerce.name }}</strong> por un monto de <strong>{{ currency }} {{ amount | format_amount }}</strong>{% if authorized_date %} el día <strong>{{ authorized_date | format_date }}</strong>{% endif %}.
        </p>
    </div>
</div>

<div style='display:block; font-family: Arial;'>
    <div style='display:block;'>
        <table width='auto' border='0' align='center' cellpadding='1' cellspacing='1'
               style='padding:15px; background-color:#f4f4f2; border-radius: 7px;'>
            <tbody>
            <tr>
                <td colspan='2'
                    style='font-family:Arial;font-size:13px;color:#565856;text-align: center;'>
                    <strong style='font-size: 15px;'>Detalle de la transferencia</strong>
                </td>
            </tr>
            <tr>
                <td style='padding: 10px;'>
                    <img src='{{ resources_base_url }}/elements-img/ico-elements/ico-money.png'>
                </td>
                <td style='font-family:Arial;font-size:15px;color:#565856; padding: 10px;'>
                    <strong>{{ currency }} {{ amount | format_amount }}</strong>
                </td>
            </tr>
            <tr>
                <td style='font-family:Arial;font-size:13px;color:#565856;padding: 10px;'>
                    <strong>Entidad emisora:</strong>
                </td>
                <td style='font-family:Arial;font-size:13px;color:#565856;padding: 10px;'>
                    {{ commerce.fantasy_name or commerce.name }}
                </td>
            </tr>
            <tr>
                <td style='font-family:Arial;font-size:13px;color:#565856;padding: 10px;'>
                    <strong>Beneficiario:</strong>
                </td>
                <td style='font-family:Arial;font-size:13px;color:#565856;padding: 10px;'>
                    {{ destination_account_holder_name or destination_account }}
                </td>
            </tr>
            {% if cuit %}
                <tr>
                    <td style='font-family:Arial;font-size:13px;color:#565856;padding: 10px;'>
                        <strong>CUIT:</strong>
                    </td>
                    <td style='font-family:Arial;font-size:13px;color:#565856;padding: 10px;'>
                        {{ cuit }}
                    </td>
                </tr>
            {% endif %}
            {% if concept %}
                <tr>
                    <td style='font-family:Arial;font-size:13px;color:#565856;padding: 10px;'>
                        <strong>Concepto:</strong>
                    </td>
                    <td style='font-family:Arial;font-size:13px;color:#565856;padding: 10px;'>
                        {{ concept }}
                    </td>
                </tr>
            {% endif %}
            {% if authorized_date %}
                <tr>
                    <td style='font-family:Arial;font-size:13px;color:#565856;padding: 10px;'>
                        <strong>Fecha de pago:</strong>
                    </td>
                    <td style='font-family:Arial;font-size:13px;color:#565856;padding: 10px;'>
                        {{ authorized_date | format_date }}
                    </td>
                </tr>
            {% endif %}
            </tbody>
        </table>
    </div>

    <div style='padding:15px 30px; display:block; font-family:Arial; font-size:11px; color:#999999; text-align:center'>
        <p>
            Este mensaje confirma que la operación se ha procesado correctamente en el sistema de Pago TIC.
        </p>
        <p>
            Si no reconocés esta transacción, comunicate con el área de soporte de tu entidad.
        </p>
    </div>
</div>

{% include "partials/commerce-site-enabled-button.html.j2" %}
<br>
{% if urlAdvertisingImg %}
    <div align='center'>
        <br>
        <a href="{{ linkAdvertisingImg }}">
            <img src="{{ urlAdvertisingImg }}" style="width: 100%;">
        </a>
    </div>
{% endif %}
{% include "partials/payer-service-contact.html.j2" %}
{% endblock %}

{% block footer %}
    {% include "partials/footer.html.j2" %}
{% endblock %}
