{#- Ported from legacy email/payment_rejected.ftl. Consumes payload.payments[] + commerce + properties + payer labels. -#}
{% extends "base.html.j2" %}

{% block title %}{{ msg('siteTitle') }}{% endblock %}

{% block header %}
    {% include "partials/header.html.j2" %}
{% endblock %}

{% block content %}
<div style='display:block;'>
    <div style='text-align: center;'>
        {% if (payments | length) <= 1 %}
            <p style='font-family: Arial; font-weight: bold; font-size: 18px; color: #565856;'>Pago Rechazado</p>
        {% else %}
            <p style='font-family: Arial; font-weight: bold; font-size: 18px; color: #565856;'>Pagos Rechazados</p>
        {% endif %}
        <img src='{{ resources_base_url }}/elements-img/ico-title/ico-rejected.png'>
    </div>
    <div style='padding:15px 30px; display:block; font-family:Arial; font-size:13px; color:#565856; text-align:center'>
        <p style='font-size:15px;color:#565856;'>
            ¡Hola {{ customer_name | capitalize_words }}!</p>
        {% if (payments | length) <= 1 %}
            <p>Desde Pago TIC lamentamos informarte que tu pago a <strong>{{ commerce.fantasy_name or commerce.name }}</strong> fue rechazado
                <br>
                <br>
                Te sugerimos reintentar con otro medio de pago.
                <br>
                Si el problema persiste, podés comunicarte con nosotros al 0810-220-5555 o <strong>con tu medio de pago en caso que el problema persista.</strong>
                <br>
                <br>
                Te compartimos el detalle del pago:
            </p>
        {% else %}
            <p>Desde Pago TIC lamentamos informarte que tus pagos a <strong>{{ commerce.fantasy_name or commerce.name }}</strong> fueron rechazados
                <br>
                <br>
                Te sugerimos reintentar con otro medio de pago.
                <br>
                Si el problema persiste, podés comunicarte con nosotros al 0810-220-5555.
                <br>
                <br>
                Te compartimos el detalle de cada transacci&oacute;n:
            </p>
        {% endif %}
    </div>
</div>

<div style='display:block;'>
    {% if (payments | length) > 1 %}
        <table width='auto' border='0' align='center' cellpadding='1' cellspacing='1'
               style='width:100%;padding:15px;background-color:#f4f4f2;border-radius: 7px;'>
            <tr>
                {% if properties.externalReferenceUse == "true" %}
                    <td align='center'
                        style='font-family:Arial;font-size:10px;color:#565856;border-bottom:1px solid #cccccc'>
                        <strong>
                            {{ labelExternalReference }}
                        </strong>
                    </td>
                {% elif properties.identificationNumberUse == "true" %}
                    <td align='center'
                        style='font-family:Arial;font-size:10px;color:#565856;border-bottom:1px solid #cccccc'>
                        <strong>
                            {{ labelIdentificationNumber }}
                        </strong>
                    </td>
                {% endif %}
                <td align='center'
                    style='font-family:Arial;font-size:10px;color:#565856;border-bottom:1px solid #cccccc'>
                    Nombre
                </td>
                <td align='center'
                    style='font-family:Arial;font-size:10px;color:#565856;border-bottom:1px solid #cccccc'>
                    Concepto
                </td>
                <td align='center'
                    style='font-family:Arial;font-size:10px;color:#565856;border-bottom:1px solid #cccccc'>
                    Fecha de rechazo
                </td>
                <td align='center'
                    style='font-family:Arial;font-size:10px;color:#565856;border-bottom:1px solid #cccccc'>
                    Medio de pago
                </td>
                <td align='center'
                    style='font-family:Arial;font-size:10px;color:#565856;border-bottom:1px solid #cccccc'>
                    Monto
                </td>
                <td align='center'
                    style='font-family:Arial;font-size:10px;color:#565856;border-bottom:1px solid #cccccc'>
                    Motivo
                </td>
                <td align='center'
                    style='font-family:Arial;font-size:10px;color:#565856;border-bottom:1px solid #cccccc'>
                </td>
            </tr>
            {% for p in payments %}
                <tr>
                    {% if p.payer.external_reference %}
                        <td align='center'
                            style='font-family:Arial; font-size:11px; color:#565856;border-bottom: 1px solid #cccccc'>
                            <a href='{{ p.form_url }}' target='_blank'
                               style='text-decoration: none; color:#565856;'>{{ p.payer.external_reference }}
                            </a>
                        </td>
                    {% elif p.payer.identification %}
                        <td align='center'
                            style='font-family:Arial; font-size:11px; color:#565856;border-bottom: 1px solid #cccccc'>
                            <a href='{{ p.form_url }}' target='_blank'
                               style='text-decoration: none; color:#565856;'>{{ p.payer.identification.number }}
                            </a>
                        </td>
                    {% endif %}
                    <td align='center'
                        style='font-family:Arial; font-size:11px; color:#565856;border-bottom: 1px solid #cccccc; padding: 10px'>
                        {{ customer_name | capitalize_words }}</td>
                    <td align='center'
                        style='font-family:Arial; font-size:11px; color:#565856;border-bottom: 1px solid #cccccc'>
                        <div style="overflow: hidden;white-space: nowrap;text-overflow: ellipsis;max-width: 150px;">
                            {% for d in p.details %}
                                {{ d.concept_description }}
                            {% endfor %}
                        </div>
                    </td>
                    <td align='center'
                        style='font-family:Arial; font-size:11px; color:#565856;border-bottom: 1px solid #cccccc'>{{ payments[0].rejected_date | format_date }}</td>
                    <td align='center'
                        style='font-family:Arial; font-size:11px; color:#565856;border-bottom: 1px solid #cccccc'>
                        {% if p.payment_methods %}
                            {% set pm = p.payment_methods[0] %}
                            {{ pm.media_payment_detail }}
                            {{ pm.last_four_digits or "XXXX" }}
                        {% endif %}
                    </td>
                    <td align='center'
                        style='font-family:Arial; font-size:11px; color:#565856;border-bottom: 1px solid #cccccc'>{{ p.currency_id }} {{ p.final_amount | format_amount }}</td>
                    <td align='center'
                        style='font-family:Arial; font-size:11px; color:#565856;border-bottom: 1px solid #cccccc'>{{ p.status_detail }}</td>
                    <td align='center'
                        style='font-family:Arial;font-size:11px;color:#565856;border-bottom:1px solid #cccccc;margin: 5px'>
                        {% if p.id %}
                            <a class="btn"
                               target="_blank"
                               href='{{ p.form_url }}'
                               style="background-color: #1E1248; color: #ffffff; text-decoration: none; padding: 5px; border-radius: 3px; ">
                                REINTENTAR PAGO
                            </a>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </table>
    {% else %}
        <div style='display:block;'>
            <table width='auto' border='0' align='center' cellpadding='1' cellspacing='1'
                   style='padding:15px; background-color:#f4f4f2; border-radius: 7px;'>
                <tbody>
                <tr>
                    <td colspan='100'
                        style='font-family:Arial;font-size:13px;color:#565856;text-align: center;'>
                        {% for d in payments[0].details %}
                            <strong style='font-size: 15px;'>{% if not loop.first %} - {% endif %}{{ d.concept_description | capitalize_words }}</strong>
                        {% endfor %}
                        <br>
                        {% if payments[0].payer.external_reference %}
                            {{ labelExternalReference }}:  {{ payments[0].payer.external_reference }}
                        {% elif payments[0].payer.identification %}
                            {{ labelIdentificationNumber }}:  {{ payments[0].payer.identification.number }}
                        {% endif %}
                        <br>
                        {{ customer_name | capitalize_words }}
                        <br>
                        Fecha de rechazo: {{ payments[0].rejected_date | format_date }}
                        <br>
                        <strong>Motivo: {{ payments[0].status_detail }}</strong>
                    </td>
                </tr>
                <tr>
                    <td style='text-align: center;'>
                        <img style='padding: 20px 0 5px 0;'
                             src='{{ resources_base_url }}/elements-img/ico-elements/ico-money.png'>
                    </td>
                    {% if payments[0].payment_methods %}
                        {% set pm = payments[0].payment_methods[0] %}
                        <td style='text-align: center;'>
                            {{ pm.media_payment_detail }}
                        </td>
                    {% endif %}
                </tr>
                <tr>
                    <td style='font-family:Arial;font-size:15px;color:#565856;text-align: center;width: 50%;'>
                        <p style='margin-top: 0;'>{{ payments[0].currency_id }} {{ payments[0].final_amount | format_amount }}</p>
                    </td>
                    {% if payments[0].payment_methods %}
                        {% set pm = payments[0].payment_methods[0] %}
                        <td style='font-family:Arial;font-size:15px;color:#565856;text-align: center;width: 50%;'>
                            <p style='margin-top: 0;'>
                                {{ pm.last_four_digits or "XXXX" }}
                            </p>
                        </td>
                    {% endif %}
                </tr>
                {% if payments[0].id %}
                    <tr>
                        <td colspan='100'
                            style='font-family:Arial;font-size:13px;color:#565856;text-align: center;'>
                            <a class="btn"
                               target="_blank"
                               href='{{ payments[0].form_url }}'
                               style="background-color: #1E1248; color: #ffffff; text-decoration: none; padding: 5px; border-radius: 3px; ">
                                REINTENTAR PAGO
                            </a>
                        </td>
                    </tr>
                {% endif %}
                </tbody>
            </table>
        </div>
    {% endif %}
    {% if (payments | length) > 10 %}
        <p align='center'>
            <a href="https://billetera.paypertic.com/"
               style='background-color:#E50051;color:#ffffff;text-decoration:none;padding:5px 8px;border-radius:3px;font-size: 14px;'>
                Ver listado completo de pagos
            </a>
        </p>
    {% endif %}
</div>
{% include "partials/commerce-site-enabled-button.html.j2" %}
<br>
{% include "partials/wallet-invitation.html.j2" %}
{% if urlAdvertisingImg %}
    <div align='center'>
        <br>
        <a href="{{ linkAdvertisingImg }}">
            <img src="{{ urlAdvertisingImg }}" style="width: 100%;">
        </a>
    </div>
{% endif %}
{% include "partials/payer-service-contact.html.j2" %}
{% endblock %}

{% block footer %}
    {% include "partials/footer.html.j2" %}
{% endblock %}
