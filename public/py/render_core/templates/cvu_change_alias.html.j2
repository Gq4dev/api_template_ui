{#- Ported from legacy email/cvu_change_alias.ftl. Consumes name, alias, cuit, cvu. -#}
{% extends "base.html.j2" %}

{% block title %}{{ msg('siteTitle') }}{% endblock %}

{% block header %}
    {% include "partials/collector-header.html.j2" %}
{% endblock %}

{% block content %}
        <div style="background-color: white;display: block;padding: 10px;text-align: center; font-family: Arial;size: 1em;           color: #565856;">
            <div style="color: #565857;font-weight: bold;margin-bottom: 4px;">CVU - Cambio de alias</div>
            <div style="margin-bottom: 20px;margin-top: 20px">
                <img src='{{ resources_base_url }}/elements-img/ico-elements/ico-editar.png'/>
            </div>
            <div>!Hola <span style="color: #565857;font-weight: bold;">{{ name }}</span></div>
            <div style="margin-top: 20px;margin-bottom: 30px">Tu alias a sido modificado de forma exitosa.</div>
            <div style="background-color: #F4F4F2;padding: 30px; display: inline-block; border-radius: 8px;">
                <div style="margin-bottom: 4px">Tu nuevo alias es:</div>
                <div style="color: #565857;font-weight: bold; margin-bottom: 4px;">{{ alias }}</div>
                <div style="margin-top: 40px; text-align: start">
                    <div>Asociado a ************************</div>
                    <br>
                    <div style="margin-bottom: 4px">CUIT:</div>
                    <div style="color: #565857;font-weight: bold; margin-bottom: 4px;">{{ cuit }}</div>
                    <br>
                    <div style="margin-bottom: 4px">Número de cuenta:</div>
                    <div style="color: #565857;font-weight: bold; margin-bottom: 4px;">{{ cvu }}</div>
                </div>
            </div>
        </div>
        {% include "partials/collector-service-contact.html.j2" %}
        {% include "partials/collector-footer.html.j2" %}
{% endblock %}
