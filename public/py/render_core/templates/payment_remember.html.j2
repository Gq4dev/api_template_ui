{#- Ported from legacy email/payment_remember.ftl. Consumes payload.payments[] + commerce + properties + payer labels + advertising. -#}
{% extends "base.html.j2" %}

{% block title %}{{ msg('siteTitle') }}{% endblock %}

{% block header %}
    {% include "partials/header.html.j2" %}
{% endblock %}

{% block content %}
<div style='display:block;'>
    <div style='text-align: center;'>
        {% if (payments | length) == 1 %}
            <p style='font-family: Arial;padding:15px 30px;text-align:left; font-weight: bold; font-size: 22px; color: #ffffff;background:#1E1248 url({{ resources_base_url }}/img/billetes.png) right center no-repeat; border-radius:10px 10px 0 0;'>Pago Emitido</p>
        {% else %}
            <p style='font-family: Arial;padding:15px 30px;text-align:left; font-weight: bold; font-size: 22px; color: #ffffff;background:#1E1248 url({{ resources_base_url }}/img/billetes.png) right center no-repeat; border-radius:10px 10px 0 0;'>Pagos Emitidos</p>
        {% endif %}
    </div>
    <div style='padding:15px 30px; display:block; font-family:Arial; font-size:13px; color:#565856; text-align:center'>
        <p style='font-size:15px;color:#565856;'>
            ¡Hola {{ customer_name | capitalize_words }}!
        </p>
        {% if (payments | length) <= 1 %}
            <p>Desde Pago TIC te informamos que tu pago a <strong>{{ commerce.fantasy_name or commerce.name }}</strong> será debitado en los próximos días.
            </p>
        {% else %}
            <p>Desde Pago TIC te informamos que tus pagos a <strong>{{ commerce.fantasy_name or commerce.name }}</strong> serán debitados en los próximos días.
            </p>
        {% endif %}
        {% if (payments | length) == 1 %}
            <p>
                Antes de que se realice el débito podés:
                <br>
                <strong>
                    - Modificar/actualizar tu medio de pago.
                    <br>
                    - Cambiar la fecha de cobro.
                    <br>
                    - Objetar el cobro para evitar el pago.
                    <br>
                </strong>
                <br>
                Además te recordamos que:
                <br>
                <strong>- Recibirás el comprobante correspondiente, entre los 3 y 5 días hábiles posteriores a la fecha de vencimiento</strong>
                <br>
                <strong>- Una vez procesados, los pagos pueden aparecer en tu resumen a nombre de Pago TIC o Pay per TIC</strong>
                <br>
                <br>
                Para realizar algún cambio, ingresá a tu
                <a target="_blank"
                   style="border-radius:3px;
                   "
                   href="https://billetera.paypertic.com/">Billetera Electrónica.
                </a>
                <br>
                Estos son los datos de tu pago:
            </p>
        {% else %}
            <p>
                Antes de que se realicen los débitos podés:
                <br>
                <strong>
                    - Modificar/actualizar tu medio de pago.
                    <br>
                    - Cambiar la fecha de cobro.
                    <br>
                    - Objetar el cobro para evitar el pago.
                    <br>
                </strong>
                <br>
                Además te recordamos que:
                <br>
                <strong>- Recibirás el comprobante correspondiente, entre los 3 y 5 días hábiles posteriores a la fecha de vencimiento</strong>
                <br>
                <strong>- Una vez procesados, los pagos pueden aparecer en tu resumen a nombre de Pago TIC o Pay per TIC</strong>
                <br>
                <br>
                Para realizar algún cambio, ingresá a tu <strong>Billetera Electrónica</strong> desde el siguiente
                <a target="_blank"
                   style="
                         text-decoration:none;
                         border-radius:3px;
                   "
                   href="https://billetera.paypertic.com/">link
                </a>
                <br>
                Estos son los datos de tus pagos:
            </p>
        {% endif %}
    </div>
</div>
<div>
    {% if (payments | length) > 1 %}
        <table width='100%' border='0' align='center' cellpadding='1' cellspacing='1'
               style='width:100%;padding:15px;background-color:#f4f4f2;border-radius: 7px;'>
            <tr>
                {% if properties.externalReferenceUse == "true" %}
                    <td align='center'
                        style="font-family:Arial;font-size:10px;font-weight:bold;color:#565856;border-bottom:1px solid #cccccc">
                        <strong>
                            {{ labelExternalReference }}
                        </strong>
                    </td>
                {% elif properties.identificationNumberUse == "true" %}
                    <td align='center'
                        style="font-family:Arial;font-size:10px;font-weight:bold;color:#565856;border-bottom:1px solid #cccccc">
                        <strong>
                            {{ labelIdentificationNumber }}
                        </strong>
                    </td>
                {% endif %}
                <td align='center'
                    style='font-family:Arial;font-size:10px;font-weight:bold;color:#565856;border-bottom:1px solid #cccccc'>
                    <strong>Apellido y Nombre</strong></td>
                <td align='center'
                    style='font-family:Arial;font-size:10px;font-weight:bold;color:#565856;border-bottom:1px solid #cccccc'>
                    <strong>Concepto</strong></td>
                <td align='center'
                    style='font-family:Arial;font-size:10px;font-weight:bold;color:#565856;border-bottom:1px solid #cccccc'>
                    <strong>Medio de<br>pago</strong></td>
                <td align='center'
                    style='font-family:Arial;font-size:10px;font-weight:bold;color:#565856;border-bottom:1px solid #cccccc'>
                    <strong>Importe a <br>Debitar</strong></td>
                <td align='center'
                    style='font-family:Arial;font-size:10px;font-weight:bold;color:#565856;border-bottom:1px solid #cccccc'>
                    <strong>Vencimiento</strong></td>
                <td align='center'
                    style='font-family:Arial;font-size:10px;font-weight:bold;color:#565856;border-bottom:1px solid #cccccc'>
                </td>
            </tr>
            {% for p in payments %}
                {% if loop.index0 < 10 %}
                    <tr>
                        {% if properties.externalReferenceUse == "true" %}
                            <td align='center'
                                style='font-family:Arial; font-size:11px; color:#565856;border-bottom: 1px solid #cccccc;padding: 10px;'>
                                {% if p.payer.external_reference %}
                                    <a href="{{ p.form_url }}" target="_blank"
                                       style="text-decoration: none; color:#565856;">{{ p.payer.external_reference }}
                                    </a>
                                {% endif %}
                            </td>
                        {% elif properties.identificationNumberUse == "true" %}
                            <td align='center'
                                style='font-family:Arial; font-size:11px; color:#565856;border-bottom: 1px solid #cccccc;padding: 10px 0px'>
                                {% if p.payer.identification %}
                                    <a href="{{ p.form_url }}" target="_blank"
                                       style="text-decoration: none; color:#565856;">{{ p.payer.identification.number }}
                                    </a>
                                {% endif %}
                            </td>
                        {% endif %}
                        <td align='center'
                            style='font-family:Arial; font-size:11px; color:#565856;border-bottom: 1px solid #cccccc;padding: 10px 0px'>{{ p.payer.name }}</td>
                        <td align='center'
                            style='font-family:Arial; font-size:11px; color:#565856;border-bottom: 1px solid #cccccc;padding: 10px 0px'>
                            {% for d in p.details %}
                                {{ d.concept_description }}
                            {% endfor %}
                        </td>
                        <td align='center'
                            style='font-family:Arial; font-size:11px; color:#565856;border-bottom: 1px solid #cccccc;padding: 10px 0px'>
                            {% if p.payment_methods %}
                                {% set pm = p.payment_methods[0] %}
                                {{ pm.media_payment_detail }}
                                {{ pm.last_four_digits }}</br>
                            {% endif %}
                        </td>
                        <td align='center'
                            style='font-family:Arial; font-size:11px; color:#565856;border-bottom: 1px solid #cccccc;padding: 10px 0px'>
                            {{ p.currency_id }} {{ p.final_amount | format_amount }}</td>
                        <td align='center'
                            style='font-family:Arial; font-size:11px; color:#565856;border-bottom: 1px solid #cccccc;padding: 10px 0px'>
                            {% if p.due_date %} {{ p.due_date | format_date }} {% endif %}</td>
                        <td align='center'
                            style='font-family:Arial;font-size:11px;color:#565856;border-bottom:1px solid #cccccc;margin: 5px;padding: 10px 0px'>
                            <a class="btn"
                               target="_blank"
                               style="background-color: #1E1248;
                                      color: #ffffff;
                                      text-decoration: none;
                                      padding: 5px;
                                      border-radius: 3px;"
                               href="https://billetera.paypertic.com/">MODIFICAR
                            </a>
                        </td>
                    </tr>
                {% endif %}
            {% endfor %}
        </table>
    {% else %}
        <div style='display:block;'>
            <table width='auto' border='0' align='center' cellpadding='1' cellspacing='1'
                   style='min-width: 350px; max-width: 95%; padding:15px; background-color:#f4f4f2; border-radius: 7px;'>
                <tbody>
                    <tr>
                        <td colspan='100'
                            style='font-family:Arial;font-size:13px;color:#565856;text-align: center;'>
                            {% for d in payments[0].details %}
                                <strong style='font-size: 15px;'>{% if not loop.first %} - {% endif %}{{ d.concept_description | capitalize_words }}</strong>
                            {% endfor %}
                            <br>
                            {% if payments[0].payer.external_reference %}
                                {{ labelExternalReference }}:  {{ payments[0].payer.external_reference }}
                            {% elif payments[0].payer.identification %}
                                {{ labelIdentificationNumber }}:  {{ payments[0].payer.identification.number }}
                            {% endif %}
                            <br>
                            {{ customer_name | capitalize_words }}
                            <br>
                            Vencimiento: {% if payments[0].due_date %}{{ payments[0].due_date | format_date }}{% endif %}
                        </td>
                    </tr>
                    <tr>
                        <td style='text-align: center;'>
                            <img style='padding: 20px 0 5px 0;'
                                 src='{{ resources_base_url }}/elements-img/ico-elements/ico-money.png'>
                        </td>
                        {% if payments[0].payment_methods %}
                            <td style='text-align: center;'>
                                {{ payments[0].payment_methods[0].media_payment_detail }}
                            </td>
                        {% endif %}
                    </tr>
                    <tr>
                        <td style='font-family:Arial;font-size:15px;color:#565856;text-align: center;width: 50%;'>
                            <p style='margin-top: 0;'>{{ payments[0].currency_id }} {{ payments[0].final_amount | format_amount }}</p>
                        </td>
                        {% if payments[0].payment_methods %}
                            {% set pm = payments[0].payment_methods[0] %}
                            <td style='font-family:Arial;font-size:15px;color:#565856;text-align: center;width: 50%;'>
                                <p style='margin-top: 0;'>{{ pm.last_four_digits }}</p>
                            </td>
                        {% else %}
                            <td style='font-family:Arial;font-size:15px;color:#565856;text-align: center;width: 50%;'>
                                <p style='margin-top: 0;'>Sin medio de pago</p>
                            </td>
                        {% endif %}
                    </tr>
                    <tr>
                        <td colspan="2"
                            style="font-family:Arial;font-size:13px;color:#333333; text-align: center; padding-top:20px;">
                            <a class="btn" target="_blank" style="
                                                   margin-top: 80px;
                                                   background-color:#1E1248;
                                                   color:#ffffff;
                                                   text-decoration:none;
                                                   padding: 5px 7px;
                                                   border-radius:3px;
                                                    "
                               href="https://billetera.paypertic.com/">MODIFICAR
                            </a>
                        </td>
                    </tr>
                    {% if (payments | length) > 10 %}
                        <p align='center'>
                            <a href="https://billetera.paypertic.com/"
                               style='background-color:#E50051;color:#ffffff;text-decoration:none;padding:5px 8px;border-radius:3px;font-size: 14px;'>
                                Ver listado completo de pagos
                            </a>
                        </p>
                    {% endif %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% include "partials/commerce-site-enabled-button.html.j2" %}
<br>
{% include "partials/wallet-invitation.html.j2" %}
    {% if urlAdvertisingImg %}
        <div align='center'>
            <br>
            <a href="{{ linkAdvertisingImg }}">
                <img src="{{ urlAdvertisingImg }}" style="width: 100%;">
            </a>
        </div>
    {% endif %}
{% include "partials/payer-service-contact.html.j2" %}
{% endblock %}

{% block footer %}
    {% include "partials/footer.html.j2" %}
{% endblock %}
